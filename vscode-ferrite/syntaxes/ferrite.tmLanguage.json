{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ferrite E2E",
  "scopeName": "source.ferrite",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#selectors" },
    { "include": "#refs" },
    { "include": "#durations" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#methods" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#macro-call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ferrite",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.ferrite",
          "match": "#.*$"
        },
        {
          "name": "comment.block.ferrite",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.ferrite",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.double.ferrite",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.single.ferrite",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-interpolation" },
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.ferrite",
          "match": "\\\\([\"'\\\\nrt$])"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.interpolation.ferrite",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.ferrite" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.ferrite" }
          },
          "patterns": [
            {
              "name": "variable.other.interpolated.ferrite",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "support.class.selector.ferrite",
          "match": "\\$(text|role)?(?=\\s*\\()"
        }
      ]
    },
    "refs": {
      "patterns": [
        {
          "name": "entity.name.tag.ref.ferrite",
          "match": "@[A-Za-z0-9_-]+"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.ferrite",
          "match": "\\b[0-9]+(ms|s|m)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ferrite",
          "match": "-?\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ferrite",
          "match": "-?\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ferrite",
          "match": "\\b(suite|import|beforeEach|macro|fn|function|test|let|const|await|use)\\b"
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "entity.name.function.method.ferrite",
          "match": "(?<=\\.)(eq|nth|first|exact|timeout|click|dblclick|hover|fill|val|press|type|sleep|wait|visible|hidden|count|shouldBeVisible|shouldBeHidden|shouldHaveCount|isVisible|isHidden|start|clear|noErrors|no_errors|expect)(?=\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ferrite",
          "match": "\\b(goto|sleep|wait|reload|press|type|snapshot|screenshot|console|mock|cdp|tab)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ferrite",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "macro-call": {
      "patterns": [
        {
          "name": "entity.name.function.macro.ferrite",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.ferrite",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "keyword.operator.assignment.ferrite",
          "match": "[=,.;:]"
        }
      ]
    }
  }
}
