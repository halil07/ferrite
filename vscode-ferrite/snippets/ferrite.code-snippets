{
  "Suite Header": {
    "prefix": "suite",
    "body": [
      "suite(\"${1:my-e2e-suite}\");",
      "",
      "test(\"${2:happy-path}\") {",
      "  await goto(\"${3:https://example.com}\");",
      "  await $(\"${4:#app}\").expect().visible();",
      "  $0",
      "}"
    ],
    "description": "Create a jQuery-style .ferrite E2E suite skeleton"
  },
  "Test Block": {
    "prefix": "test",
    "body": [
      "test(\"${1:test-case-name}\") {",
      "  $0",
      "}"
    ],
    "description": "Add a test case block"
  },
  "Macro Definition": {
    "prefix": "macro",
    "body": [
      "macro ${1:helper_name}(${2:param}) {",
      "  $0",
      "}"
    ],
    "description": "Define a reusable .ferrite macro"
  },
  "jQuery Click": {
    "prefix": "$click",
    "body": [
      "await $(\"${1:.btn:eq(0)}\").click();"
    ],
    "description": "Select with CSS and click"
  },
  "jQuery Fill + Enter": {
    "prefix": "$fill",
    "body": [
      "await $(\"${1:input}\").fill(\"${2:value}\").press(\"Enter\");"
    ],
    "description": "Select input, fill value, and press Enter"
  },
  "Expect Visible": {
    "prefix": "$visible",
    "body": [
      "await $(\"${1:.selector}\").expect().visible();"
    ],
    "description": "Select element and assert it is visible"
  },
  "Expect Count": {
    "prefix": "$count",
    "body": [
      "await $(\"${1:.item}\").expect().count(${2:1});"
    ],
    "description": "Select elements and assert match count"
  },
  "Mock Route File": {
    "prefix": "mock",
    "body": [
      "await mock(\"${1:GET}\", \"${2:real_service}\", \"${3:mock.json}\");"
    ],
    "description": "Intercept and mock an HTTP route using a fixture file"
  },
  "Sleep": {
    "prefix": "sleep",
    "body": [
      "await sleep(${1:1s});"
    ],
    "description": "Wait for a duration"
  },
  "Screenshot Assertion": {
    "prefix": "screenshot",
    "body": [
      "await screenshot(\"${1:screen-name}\", ${2:0.1}, ${3:0.005});"
    ],
    "description": "Assert pixelmatch visual regression baseline"
  }
}
