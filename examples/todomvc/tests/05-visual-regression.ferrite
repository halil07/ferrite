suite("todomvc-05-visual-regression");
import "./helpers/todomvc.ferrite";

beforeEach {
  await open_clean_app();
}

test("visual-baseline-empty-and-mixed-list") {
  await $(".todo-list li").expect().count(0);
  await screenshot("todomvc-empty", 0.1, 0.005);

  await add_todo("Ship Ferrite DSL");
  await add_todo("Review visual diff");
  await toggle_first_todo();
  await $(".todo-list li").expect().count(2);
  await $(".todo-list li.completed").expect().count(1);
  await $text("1 item left").expect().visible();

  await screenshot("todomvc-mixed-list", 0.1, 0.005);
}
