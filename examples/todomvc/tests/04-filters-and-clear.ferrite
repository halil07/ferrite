suite("todomvc-04-filters-and-clear");
import "./helpers/todomvc.ferrite";

beforeEach {
  await open_clean_app();
  await add_todo("Active One");
  await add_todo("Completed One");
  await add_todo("Active Two");
  await toggle_second_todo();
  await $(".todo-list li").expect().count(3);
  await $(".todo-list li.completed").expect().count(1);
  await $text("2 items left").expect().visible();
}

test("filter-active-completed-and-all-routes") {
  await $('.filters a[href="#/active"]').click();
  await $(".todo-list li").expect().count(2);
  await $text("Active One").expect().visible();
  await $text("Active Two").expect().visible();
  await $text("Completed One").expect().hidden();

  await $('.filters a[href="#/completed"]').click();
  await $(".todo-list li").expect().count(1);
  await $text("Completed One").expect().visible();
  await $text("Active One").expect().hidden();
  await $text("Active Two").expect().hidden();

  await $('.filters a[href="#/"]').click();
  await $(".todo-list li").expect().count(3);
  await $text("Active One").expect().visible();
  await $text("Completed One").expect().visible();
  await $text("Active Two").expect().visible();
}

test("clear-completed-removes-only-finished-todos") {
  await $(".clear-completed").click();
  await $(".todo-list li").expect().count(2);
  await $(".todo-list li.completed").expect().count(0);
  await $text("Completed One").expect().hidden();
  await $(".clear-completed").expect().hidden();
  await $text("Active One").expect().visible();
  await $text("Active Two").expect().visible();
  await $text("2 items left").expect().visible();
}
