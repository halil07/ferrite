suite "todomvc-04-filters-and-clear"
import "./helpers/todomvc.ferrite"

beforeEach {
  use open_clean_app()
  use add_todo("Active One")
  use add_todo("Completed One")
  use add_todo("Active Two")
  use toggle_second_todo()
  expect count css ".todo-list li" 3
  expect count css ".todo-list li.completed" 1
  expect visible "2 items left"
}

test "filter-active-completed-and-all-routes" {
  click css ".filters a[href=\"#/active\"]" timeout 5s
  expect count css ".todo-list li" 2
  expect visible "Active One"
  expect visible "Active Two"
  expect hidden "Completed One"

  click css ".filters a[href=\"#/completed\"]" timeout 5s
  expect count css ".todo-list li" 1
  expect visible "Completed One"
  expect hidden "Active One"
  expect hidden "Active Two"

  click css ".filters a[href=\"#/\"]" timeout 5s
  expect count css ".todo-list li" 3
  expect visible "Active One"
  expect visible "Completed One"
  expect visible "Active Two"
}

test "clear-completed-removes-only-finished-todos" {
  click css ".clear-completed" timeout 5s
  expect count css ".todo-list li" 2
  expect count css ".todo-list li.completed" 0
  expect hidden "Completed One"
  expect hidden css ".clear-completed"
  expect visible "Active One"
  expect visible "Active Two"
  expect visible "2 items left"
}
