// Shared jQuery-style helpers for https://todomvc.com/examples/react/dist/

let app_url = "https://todomvc.com/examples/react/dist/";

macro open_clean_app() {
  await goto("about:blank", "load", 10s);
  await goto("${app_url}", "load", 15s);
  await $("input.new-todo").expect().visible(10s);
}

macro add_todo(title) {
  await $("input.new-todo").fill("${title}").press("Enter");
}

macro toggle_all() {
  await $(".toggle-all").click();
}

macro toggle_first_todo() {
  await $(".todo-list li .toggle:eq(0)").click();
}

macro toggle_second_todo() {
  await $(".todo-list li .toggle:eq(1)").click();
}

macro edit_first_todo(new_title) {
  await $(".todo-list li label:eq(0)")
    .dblclick()
    .press("Control+a")
    .press("Backspace")
    .type("${new_title}")
    .press("Enter");
}

macro edit_first_todo_on_blur(new_title) {
  await $(".todo-list li label:eq(0)")
    .dblclick()
    .press("Control+a")
    .press("Backspace")
    .type("${new_title}");
  await $("header.header h1").click();
}

macro delete_first_todo() {
  await $(".todo-list li:eq(0)").hover();
  await $(".todo-list li .destroy:eq(0)").click();
}
