suite("todomvc-01-initial-and-create");
import "./helpers/todomvc.ferrite";

beforeEach {
  await open_clean_app();
  await console.start();
  await console.clear();
}

test("initial-empty-state") {
  await $("header.header h1").expect().visible();
  await $("input.new-todo").expect().visible();
  await $(".todo-list li").expect().count(0);
  await $(".footer").expect().hidden();
  await console.noErrors();
}

test("create-single-and-multiple-todos") {
  await add_todo("Buy milk");
  await $(".todo-list li").expect().count(1);
  await $(".footer").expect().visible();
  await $text("Buy milk").expect().visible();
  await $text("1 item left").expect().visible();

  await add_todo("Walk the dog");
  await add_todo("Read Rust book");
  await $(".todo-list li").expect().count(3);
  await $text("Walk the dog").expect().visible();
  await $text("Read Rust book").expect().visible();
  await $text("3 items left").expect().visible();
  await console.noErrors();
}

test("trim-whitespace-and-ignore-empty-inputs") {
  // Whitespace-only inputs are ignored by React TodoMVC
  await add_todo("   ");
  await $(".todo-list li").expect().count(0);
  await $(".footer").expect().hidden();

  await add_todo("   Learn Ferrite   ");
  await $(".todo-list li").expect().count(1);
  await $text("Learn Ferrite").exact().expect().visible();
  await $text("1 item left").expect().visible();
}
