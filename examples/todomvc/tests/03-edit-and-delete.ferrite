suite("todomvc-03-edit-and-delete");
import "./helpers/todomvc.ferrite";

beforeEach {
  await open_clean_app();
}

test("edit-todo-on-double-click-and-enter") {
  await add_todo("Write unit tests");
  await $(".todo-list li").expect().count(1);
  await $text("Write unit tests").expect().visible();

  await edit_first_todo("Write E2E tests");
  await $(".todo-list li").expect().count(1);
  await $text("Write E2E tests").expect().visible();
  await $text("Write unit tests").expect().hidden();
  await $text("1 item left").expect().visible();
}

test("commit-edit-on-blur-saves-updated-title") {
  await add_todo("Keep original title");
  await edit_first_todo_on_blur("Saved on blur");

  await $(".todo-list li").expect().count(1);
  await $(".todo-list li.editing").expect().hidden();
  await $text("Saved on blur").expect().visible();
  await $text("Keep original title").expect().hidden();
}

test("delete-todo-via-hover-destroy-button") {
  await add_todo("First task");
  await add_todo("Second task");
  await $(".todo-list li").expect().count(2);
  await $text("2 items left").expect().visible();

  await delete_first_todo();
  await $(".todo-list li").expect().count(1);
  await $text("First task").expect().hidden();
  await $text("Second task").expect().visible();
  await $text("1 item left").expect().visible();

  await delete_first_todo();
  await $(".todo-list li").expect().count(0);
  await $text("Second task").expect().hidden();
  await $(".footer").expect().hidden();
}
