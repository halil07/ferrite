suite("todomvc-02-complete-and-toggle-all");
import "./helpers/todomvc.ferrite";

beforeEach {
  await open_clean_app();
}

test("toggle-single-todo-complete-and-back") {
  await add_todo("Task One");
  await add_todo("Task Two");
  await $(".todo-list li").expect().count(2);
  await $(".todo-list li.completed").expect().count(0);
  await $text("2 items left").expect().visible();

  await toggle_first_todo();
  await $(".todo-list li.completed").expect().count(1);
  await $text("1 item left").expect().visible();
  await $(".clear-completed").expect().visible();

  // Uncheck back to active
  await toggle_first_todo();
  await $(".todo-list li.completed").expect().count(0);
  await $text("2 items left").expect().visible();
  await $(".clear-completed").expect().hidden();
}

test("toggle-all-complete-and-uncomplete") {
  await add_todo("Alpha");
  await add_todo("Beta");
  await add_todo("Gamma");
  await $(".todo-list li").expect().count(3);
  await $text("3 items left").expect().visible();

  await toggle_all();
  await $(".todo-list li.completed").expect().count(3);
  await $text("0 items left").expect().visible();
  await $(".clear-completed").expect().visible();

  await toggle_all();
  await $(".todo-list li.completed").expect().count(0);
  await $text("3 items left").expect().visible();
  await $(".clear-completed").expect().hidden();
}
